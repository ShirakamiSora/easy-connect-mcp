{
  "name": "easy-connect-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --prefix apps/server run start",
    "build": "tsc -p tsconfig.base.json --noEmit && npm --prefix apps/web run build",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify:private:fixtures": "node --test scripts/verify-private-files.test.mjs",
    "verify:private": "node scripts/verify-private-files.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0",
    "jsdom": "^24.0.0"
  }
}
